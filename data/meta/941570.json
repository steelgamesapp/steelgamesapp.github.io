/1fad5e24fb11d12c8470c4eb8079814d9e19918f/1751166774/hls_264_master.m3u8?t=1599222388","mp4":"https://cdn.akamai.steamstatic.com/steam/apps/256794743/movie480.mp4"}],"genres":["Action","Adventure","Indie"],"features":["Single-player","Steam Achievements","Steam Cloud","Family Sharing"],"platforms":{"windows":true,"mac":false,"linux":false},"controller":"full","dev":["Mighty Polygon"],"pub":["Ravenscourt"],"released":"Aug 3, 2020","meta":74,"langs":["English","Spanish - Spain","French","Italian","German","Japanese","Korean","Polish","Portuguese - Brazil","Russian","Simplified Chinese","Traditional Chinese"],"min":[["OS","Windows 7 64-bit"],["Processor","Core i3 / Athlon 64 X2 6400"],["Memory","4 GB RAM"],["Graphics","NVIDIA GeForce GTX 560 / ATI Radeon HD 5770"],["DirectX","Version 11"],["Storage","12 GB available space"]],"rec":[["OS","Win 7 64bit / Win 8.1 64-bit / Windows 10"],["Processor","Core i7 / A8-3870K or above"],["Memory","8 GB RAM"],["Graphics","NVIDIA GeForce GTX 970 / ATI Radeon R9 280 or above"],["DirectX","Version 11"],["Storage","12 GB available space"]],"deck":3,"blurb":"Stranded in the abandoned Chandra Base on the Moon, you play a physicist whose tools are magnetism and gravity in this first-person puzzle game. By manipulating both, you solve physics-based puzzles that open the way through the base and the terraformed craters around it. The stakes are personal, since your daughter's life depends on your scientific skill.\n\nYou can push straight ahead toward safety or take time to gather clues about the politics of the 22nd-century Moon and the secret hidden in the lunar craters. It is single-player with full controller support, suited to puzzle fans who enjoy experimenting with physics rules and a sci-fi mystery that unfolds as they explore."}}