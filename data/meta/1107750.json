165.jpg?t=1629792112","hls":"https://video.akamai.steamstatic.com/store_trailers/1107750/395125/184e1a9e0db12052be9158a2af4ed61f6687f951/1751189555/hls_264_master.m3u8?t=1629792112","mp4":"https://cdn.akamai.steamstatic.com/steam/apps/256848063/movie480.mp4"}],"genres":["Adventure","Indie"],"features":["Single-player","Steam Achievements","Steam Cloud","Family Sharing"],"platforms":{"windows":true,"mac":false,"linux":true},"controller":"full","dev":["Red Koi Box"],"pub":["Deck13"],"released":"Aug 12, 2021","meta":null,"langs":["English","Italian","French","German","Spanish - Spain","Russian"],"min":[["OS","Windows 7 64bit or later"],["Processor","Quad-core Intel or AMD processor, 2.5 GHz or faster"],["Memory","8 GB RAM"],["Graphics","NVIDIA GeForce 770 GTX or AMD Radeon HD 7970 or higher"],["DirectX","Version 11"],["Storage","4 GB available space"]],"rec":[["OS","Windows 10 64bit"],["Processor","Quad-core Intel or AMD processor, 3.0 GHz or faster"],["Memory","16 GB RAM"],["Graphics","NVIDIA GeForce 970 or AMD Radeon R9 290 or higher"],["DirectX","Version 11"],["Storage","4 GB available space"]],"deck":3,"blurb":"Raug Zeekon, an interstellar archaeologist, is sent by his company to investigate a mysterious signal from an unexplored star in this first-person puzzle game. On arrival he finds the Bia-Tool, an alien relic shaped like a pistol that can absorb energy and send it to other machinery. Using it, you work through temples and solve puzzles that get tougher the deeper you go.\n\nProgress comes from routing energy between devices, which rewards observation and logic. Single-player with full controller support, Faraday Protocol suits players who enjoy methodical, thought-heavy puzzle games and discovering how an unfamiliar tool works."}}