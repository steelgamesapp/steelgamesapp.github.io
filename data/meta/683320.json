.akamai.steamstatic.com/store_trailers/683320/177402/ab46f72c953f822a0cfe1d4ba1fb9278531a2c0e/1750570711/hls_264_master.m3u8?t=1534168095","mp4":"https://cdn.akamai.steamstatic.com/steam/apps/256724876/movie480.mp4"}],"genres":["Adventure","Indie"],"features":["Single-player","Steam Achievements","Steam Cloud","Remote Play on TV","Steam Trading Cards","Family Sharing"],"platforms":{"windows":true,"mac":true,"linux":false},"controller":"full","dev":["Nomada Studio"],"pub":["Devolver Digital"],"released":"Dec 13, 2018","meta":84,"langs":["English","French","German","Spanish - Spain","Japanese","Korean","Russian","Simplified Chinese","Traditional Chinese","Portuguese - Brazil"],"min":[["OS","Windows 7 or later"],["Processor","Intel Core2 Duo E6750 (2 * 2660) or equivalent / AMD Athlon 64 X2 Dual Core 5000+ (2 * 2600) or equivalent"],["Memory","4 GB RAM"],["Graphics","Geforce GT 430 (1024 MB) / Radeon HD 5570 (1024 MB)"],["Storage","4 GB available space"]],"rec":[],"deck":3,"blurb":"Grief drives the journey of Gris, a young girl adrift in a faded world after something painful in her past. Her sorrow shows in her dress, which gains new powers as she moves forward, and each ability opens paths that were closed before. As the story unfolds, she changes emotionally and the world around her looks different.\n\nThere is no death, no danger and no frustration here. Light puzzles and platforming sections appear as more of the world opens up, along with optional skill-based challenges. The story comes through delicate artwork, animation and an original score, with very little text. It is single-player with full controller support, and suits anyone after a calm, visual experience."}}