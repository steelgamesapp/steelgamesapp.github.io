red.akamai.steamstatic.com/store_item_assets/steam/apps/256661522/movie.293x165.jpg?t=1463645472","hls":"https://video.akamai.steamstatic.com/store_trailers/407810/53902/43c1aa9f3b85c40706e167b0dd65482d4122e564/1751279450/hls_264_master.m3u8?t=1463645472","mp4":"https://cdn.akamai.steamstatic.com/steam/apps/256661522/movie480.mp4"}],"genres":["Action","Adventure"],"features":["Single-player","Steam Achievements","Remote Play on TV","Steam Trading Cards","Family Sharing"],"platforms":{"windows":true,"mac":false,"linux":false},"controller":"full","dev":["Flying Wild Hog"],"pub":["Good Shepherd Entertainment"],"released":"Jun 3, 2016","meta":73,"langs":["English","French","German","Polish","Russian"],"min":[["OS","Win 7 or Later"],["Processor","2.5 GHz Intel Pentium 4 / AMD Athlon 64"],["Memory","2 GB RAM"],["Graphics","512 MB NVIDIA GeForce 8800GS / ATI Radeon HD 3870 or better"],["DirectX","Version 9.0c"],["Storage","5 GB available space"]],"rec":[],"deck":2,"blurb":"Enemies arrive in large numbers in this single-player first-person shooter, set in a cyberpunk world with highly destructible environments and a varied selection of weapons. Hard Reset Redux rebuilds the original game with reworked gameplay, upgraded visuals and extra content, while including everything from earlier editions.\n\nThe campaign is intended to be tough, and the game is built around fast, aggressive shooting. Flying Wild Hog developed it, and it supports full controller use. It suits players who enjoy old-fashioned, high-intensity shooters with a cyberpunk look and no multiplayer component, and who want a hard fight."}}