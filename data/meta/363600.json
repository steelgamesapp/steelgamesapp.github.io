69e10d355cccc84fb4f55243ff5f1.1920x1080.jpg?t=1789475246"}],"movies":[{"id":2039877,"n":"Holy Potatoes! A Weapon Shop?! Trailer","t":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2039877/movie.293x165.jpg?t=1447375838","hls":"https://video.akamai.steamstatic.com/store_trailers/363600/37128/acf2db2c145e305afebe3f4e5c7612960d3062a4/1751277492/hls_264_master.m3u8?t=1447375838","mp4":"https://cdn.akamai.steamstatic.com/steam/apps/2039877/movie480.mp4"}],"genres":["Indie","Simulation"],"features":["Single-player","Steam Achievements","Steam Cloud","Steam Trading Cards","Family Sharing"],"platforms":{"windows":true,"mac":true,"linux":true},"controller":null,"dev":["Daylight Studios"],"pub":["Daedalic Entertainment","Daylight Studios"],"released":"Jul 13, 2015","meta":69,"langs":["English","Japanese","French","German","Russian","Simplified Chinese","Spanish - Spain"],"min":[["OS","XP / Vista / 7"],["Processor","Intel 2 GHz"],["Memory","2 GB RAM"],["Graphics","1280 x 720 Minimum Resolution"],["DirectX","Version 9.0"],["Storage","3 GB available space"]],"rec":[],"deck":2,"blurb":"Running a weapon shop in a world populated by potatoes is the whole job here. You put potato smiths to work forging weapons, sell them to heroes heading out on quests, and gradually expand the business into new areas. The numbers are large for a lighthearted sim: more than 200 weapons, 70 potato heroes, 30 smiths and 20 regions, plus a potato dog you can adopt.\n\nThe design takes cues from Recettear, Game Dev Story and Weapon Shop de Omasse, so it fits players who enjoy shop management and steady growth. Pop-culture heroes make guest appearances, and the soundtrack is by Kimura Masahiko, with earlier credits on Suikoden. It is single-player."}}