0.mp4"}],"genres":["Adventure","Indie"],"features":["Single-player","Multi-player","Co-op","Shared/Split Screen Co-op","Steam Achievements","Steam Cloud","Steam Trading Cards","Family Sharing"],"platforms":{"windows":true,"mac":false,"linux":false},"controller":"full","dev":["Piccolo Studio"],"pub":["Untold Tales"],"released":"Dec 3, 2020","meta":79,"langs":["English","French","Italian","German","Spanish - Spain","Japanese","Korean","Portuguese - Portugal","Portuguese - Brazil","Russian","Simplified Chinese","Spanish - Latin America","Turkish","Polish"],"min":[["OS","Windows 7 / 8.1 / 10 (64 bit)"],["Processor","Intel Core i3 4340 3.6 GHz or AMD equivalent"],["Memory","6 GB RAM"],["Graphics","NVIDIA GeForce GTX 670 2 GB or AMD Radeon equivalent"],["DirectX","Version 11"],["Storage","6 GB available space"],["Sound Card","DirectX 9.0c Compliant"]],"rec":[["OS","Windows 10 (64 bit)"],["Processor","Intel Core i7 3770K 3.5 GHz or AMD equivalent"],["Memory","8 GB RAM"],["Graphics","NVIDIA GeForce GTX 1060 6 GB or AMD Radeon equivalent"],["DirectX","Version 11"],["Storage","6 GB available space"],["Sound Card","DirectX 9.0c Compliant"]],"deck":3,"blurb":"Arise: A Simple Story begins at the end of a man's life and sends him back through his memories, from childhood to old age. Each chapter is a large, dreamlike landscape built from one stage of his past, covering love, joy, loss and grief. The key mechanic lets you move time forward and backward within a scene, shifting the world around you to clear a path.\n\nThe game tells its story without dialogue and keeps a calm, steady pace built on light platforming and puzzles. It can be played alone or with a second person in local co-op, which suits couples or friends sharing a couch. It is a good pick for players who value emotional storytelling."}}