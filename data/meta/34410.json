kamai.steamstatic.com/store_item_assets/steam/apps/34410/ss_805a1e593c3b9e8e1f7360a58ad6505fc98b2b99.1920x1080.jpg?t=1759140467"}],"movies":[],"genres":["Action"],"features":["Single-player","Steam Cloud","Family Sharing"],"platforms":{"windows":true,"mac":false,"linux":false},"controller":null,"dev":["Haggard Games"],"pub":["Fulqrum Publishing"],"released":"Aug 7, 2009","meta":73,"langs":["English","Russian","Italian","Spanish - Spain","French"],"min":[["OS","Windows XP SP3, Windows Vista SP1 / 7 / 8 / 8.1 / 10"],["Processor","Intel Dual Core 2.0 GHz or AMD Athlon 4000+"],["Memory","XP \u2013 1 GB RAM, Vista \u2013 2 GB RAM"],["Graphics","3D Hardware Accelerator Card Required \u2013 100% DirectX 9.0c compatible 256 MB Video Memory. ATI Radeon X800, Nvidia Geforce 6800"],["Hard Drive","4.5 GB + 1 GB Swap File"],["Sound","DirectX 9.0c compatible sound card"]],"rec":[["Processor","Intel Core 2 Duo 2.4 GHz or AMD Athlon Dual Core 5200+"],["Memory","2 GB"],["Graphics","256 MB 3D Hardware Accelerator Card with Shader 3.0 support. ATI Radeon HD 3870, Nvidia Geforce 8800 GT"]],"deck":0,"blurb":"Death to Spies: Moment of Truth is the sequel to Death to Spies and continues the story of Soviet counterintelligence during World War II. You again take the role of a SMERSH agent, carrying out covert operations against German forces and enemy agents in a series of standalone missions.\n\nPlayed from a third-person view, it focuses on disguises, careful movement and choosing when to act. Missions reward patience and planning, and loud approaches tend to go badly. It is single-player only and suits players who enjoy older-style stealth action with a historical setting. Anyone who liked the first game will find more of the same approach here, with new locations to infiltrate."}}