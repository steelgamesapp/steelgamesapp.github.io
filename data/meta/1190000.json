ai.steamstatic.com/store_item_assets/steam/apps/1190000/ss_7233070eb9ed7ce6292ddf06928ef0eb5ae08873.1920x1080.jpg?t=1793732210"}],"movies":[{"id":257129486,"n":"Car Mechanic Simulator 2021 Trailer","t":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257129486/0e45c21bc8e9f1ad1db7b378ca93ec135dbddcf4/movie_600x337.jpg?t=1745365738","hls":"https://video.akamai.steamstatic.com/store_trailers/1190000/875770/f919977b0c202dea2acc4be0624e522423ef7a0c/1750636427/hls_264_master.m3u8?t=1745365738","mp4":"https://cdn.akamai.steamstatic.com/steam/apps/257129486/movie480.mp4"}],"genres":["Racing","Simulation"],"features":["Single-player","Steam Achievements","Steam Cloud","Steam Trading Cards","Family Sharing"],"platforms":{"windows":true,"mac":false,"linux":false},"controller":null,"dev":["Red Dot Games"],"pub":["PlayWay S.A."],"released":"Aug 11, 2021","meta":null,"langs":["English","French","Italian","German","Spanish - Spain","Simplified Chinese","Japanese","Polish","Portuguese - Portugal","Portuguese - Brazil","Russian","Korean","Turkish","Czech","Romanian","Arabic","Hungarian"],"min":[["OS","Windows(64-bit) 8.1 / 10"],["Processor","Intel Core i5 4690 / AMD Ryzen 5 1500X"],["Memory","8 GB RAM"],["Graphics","NVidia GeForce GTX 760 2GB"],["DirectX","Version 11"],["Storage","35 GB available space"],["Additional Notes","GAME DOES NOT SUPPORT Intel Integrated Graphics Cards"]],"rec":[["OS","Windows(64-bit) 8.1 / 10"],["Processor","Intel Core i5 6600K / AMD Ryzen 7 1700X"],["Memory","16 GB RAM"],["Graphics","NVidia GeForce GTX 1070 8GB"],["DirectX","Version 11"],["Storage","35 GB available space"],["Additional Notes","GAME DOES NOT SUPPORT Intel Integrated Graphics Cards"]],"deck":3,"blurb":"Starting with a single new garage, you grow a service business in Car Mechanic Simulator 2021. Orders keep arriving, and you handle them by taking cars apart, testing, replacing parts, painting, tuning and rebuilding, working with more than 4,000 unique parts across over 72 cars. An auction house lets you buy vehicles in various conditions, and barn finds may hide valuable cars.\n\nIncome from jobs pays for new work spaces and better equipment, which widens the services you can offer. The emphasis is on detailed, hands-on repair, and it is played solo. It suits people who enjoy methodical tinkering and watching a small business grow."}}