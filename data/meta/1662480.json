852792/movie.293x165.jpg?t=1683103676","hls":"https://video.akamai.steamstatic.com/store_trailers/1662480/403535/e5fa409f204dd87f66aaae769c43aa9db1ddbdcb/1751016292/hls_264_master.m3u8?t=1683103676","mp4":"https://cdn.akamai.steamstatic.com/steam/apps/256852792/movie480.mp4"}],"genres":["Action","Adventure","Indie"],"features":["Single-player","Steam Achievements","Steam Cloud","Family Sharing"],"platforms":{"windows":true,"mac":false,"linux":true},"controller":"full","dev":["Deepnight Games"],"pub":["Deepnight Games"],"released":"Oct 18, 2021","meta":74,"langs":["English","French","German","Spanish - Spain","Japanese","Portuguese - Brazil","Russian","Simplified Chinese","Turkish","Spanish - Latin America","Basque"],"min":[["OS","Windows 7 and up, 64bits"],["Processor","1 Ghz and up"],["Memory","2 GB RAM"],["Graphics","Any decent GPU"],["Storage","200 MB available space"]],"rec":[],"deck":1,"blurb":"Nuclear Blaze is a 2D firefighting platformer from Deepnight Games, the studio of the lead developer behind Dead Cells. You play a firefighter sent into a secret government facility to put out a spreading fire. Armed with a hose and limited water, you spray flames, break through walls and watch for backdrafts and explosions, while rescuing the occasional trapped cat. Clues hint that more is going on inside.\n\nIt is a single-player game with a short campaign and an unusual focus on putting out fires instead of fighting enemies. The action is fast and satisfying, with fire spreading in realistic ways. Nuclear Blaze suits players who want something different from the usual action platformer."}}