://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256951439/movie.293x165.jpg?t=1687426512","hls":"https://video.akamai.steamstatic.com/store_trailers/1634080/575778/fffce70ac7628d196aca0e888dfee2513064bd3a/1751012293/hls_264_master.m3u8?t=1687426512","mp4":"https://cdn.akamai.steamstatic.com/steam/apps/256951439/movie480.mp4"}],"genres":["Action","Adventure"],"features":["Single-player","Steam Achievements","Steam Cloud","Family Sharing"],"platforms":{"windows":true,"mac":false,"linux":false},"controller":"full","dev":["Sunnyside Games"],"pub":["Dear Villagers"],"released":"Jun 7, 2023","meta":81,"langs":["English","French","German","Spanish - Spain","Simplified Chinese","Portuguese - Brazil","Traditional Chinese","Japanese"],"min":[["OS","Windows 7 64-bit"],["Processor","Intel Core i7-3610QM or AMD Ryzen 5 3500U"],["Memory","8 GB RAM"],["Graphics","GeForce GT 650M or Radeon HD 4870 X2"],["Storage","2 GB available space"]],"rec":[],"deck":3,"blurb":"Nocturnal is a 2D action platformer in which a warrior returns home to find the island shrouded in a deadly mist. Fire is the key to survival: your sword can catch flame from braziers and torches, and carrying that fire lets you burn enemies, light up the darkness and push through areas where the mist would otherwise harm you. Short challenges and puzzles are built around keeping the flame alive.\n\nIt is a single-player game that can be finished in about two hours, with a hand-painted look and fast combat. The difficulty is noticeable but fair. Nocturnal suits players looking for a compact action game with a clever central idea that they can finish in an evening."}}